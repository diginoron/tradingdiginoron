# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AvalAI AI Service (OpenAI-Compatible API with Gemini models e.g. gemini-3.5-flash-lite)
AVALAI_API_KEY="avalaltrading"
AVALAI_BASE_URL="https://api.avalai.ir/v1"

# UN Comtrade Developer Subscription Keys (from https://comtradedeveloper.un.org/)
# Primary Key or Secondary Key associated with user account (e.g. DIGINORON@GMAIL.COM)
UN_COMTRADE_PRIMARY_KEY=""
UN_COMTRADE_SECONDARY_KEY=""

# Supabase Configuration (PostgreSQL Database & Auth)
# Get these from your Supabase Project Settings -> API & Database
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Client-side Supabase variables (if accessed directly from Vite frontend)
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# API Ninjas Secret Key (from https://api-ninjas.com/profile)
# Used for Live FX Multi-Currency, Country Macro Indicators (GDP, Inflation),
# Trade & Customs Holidays, Trade Finance Validator (IBAN/SWIFT) and Commodities
API_NINJAS_KEY=""

{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/*.ts": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/api/health-monitor/(.*)",
      "destination": "/api/health-monitor"
    },
    {
      "source": "/api/health-monitor",
      "destination": "/api/health-monitor"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/api",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/health-monitor?action=run&source=vercel-cron",
      "schedule": "0 3 * * *"
    }
  ]
}
